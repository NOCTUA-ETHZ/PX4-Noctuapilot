<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="magnetic_docking">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 0</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="libMagneticDockingSystem.so" name="custom::MagneticDockingSystem">
      <model_a>fixed_magnet</model_a>
      <link_a>magnet_link</link_a>
      <offset_a>0.0025 0 0</offset_a>
      <axis_a>1 0 0</axis_a>
      <model_b>test_body</model_b>
      <link_b>body_link</link_b>
      <offset_b>-0.0025 0 0</offset_b>
      <axis_b>1 0 0</axis_b>
      <capture_distance>0.15</capture_distance>
      <magnet_radius>0.015</magnet_radius>
      <magnet_length>0.005</magnet_length>
      <remanence>0.8</remanence>
      <damping>3.0</damping>
    </plugin>

    <model name="fixed_magnet">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="magnet_link">
        <collision name="collision">
          <pose>0 0 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.005</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.005</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.15 0.8 1</ambient>
            <diffuse>0.05 0.15 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="test_body">
      <pose>0.015 0 0 0 0 0</pose>
      <link name="body_link">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.000533333</ixx>
            <iyy>0.000370833</iyy>
            <izz>0.000370833</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.005</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.005</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>0.8 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="reference_floor">
      <static>true</static>
      <pose>0 0 -0.07 0 0 0</pose>
      <link name="floor_link">
        <visual name="visual">
          <geometry>
            <box><size>1.0 0.5 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.2 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>
  </world>
</sdf>
